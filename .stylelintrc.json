{
  "plugins": ["stylelint-no-unsupported-browser-features"],
  "rules": {
    "plugin/no-unsupported-browser-features": [true, {
      "browsers": ["Chrome >= 120"],
      "severity": "error"
    }],
    "selector-pseudo-class-disallowed-list": ["has"],
    "property-disallowed-list": ["/^text-decoration/"]
  }
}
