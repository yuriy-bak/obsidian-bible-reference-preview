# Keep release assets and source files byte-stable across Windows/Linux checkouts.
# GitHub artifact attestations verify exact file digests, so text assets must not
# drift between CRLF and LF when they are uploaded to a release.

* text=auto

*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
